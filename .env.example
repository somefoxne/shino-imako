# Discord Bot / Webhook Configuration
DISCORD_TOKEN=your_discord_token_here
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url_here

# Danbooru API Credentials
DANBOORU_USERNAME=your_danbooru_username_here
DANBOORU_API_KEY=your_danbooru_api_key_here

# Git Database Repository (Lấy database và update database)
DATABASE_REPO_URL=https://github.com/somefoxne/copyright_request_database.git

# Chính sách mặc định khi tag bị xóa: 'never' hoặc số lượt edit (vd: 5)
RE_ADD_POLICY=never
