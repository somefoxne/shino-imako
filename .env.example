# ==============================================================================
# HƯỚNG DẪN LẤY DANBOORU API KEY:
# 1. Đăng nhập vào https://danbooru.donmai.us
# 2. Truy cập: https://danbooru.donmai.us/profile
# 3. Kéo xuống mục "API Key" -> bấm "View API Key" (hoặc "Generate API Key")
# 4. Copy chuỗi API Key dán vào DANBOORU_API_KEY ở dưới.
#    LƯU Ý: KHÔNG ĐƯỢC dùng mật khẩu đăng nhập! Danbooru sẽ trả về lỗi HTTP 401.
# ==============================================================================

# ==============================================================================
# CHẾ ĐỘ TESTBOORU (TEST_MODE: on / off / true / false)
# ==============================================================================
TEST_MODE=off
TESTBOORU_URL=https://testbooru.donmai.us
TESTBOORU_USERNAME=your_testbooru_username
TESTBOORU_API_KEY=your_testbooru_api_key

# ==============================================================================
# DANBOORU CHÍNH THỨC (PRODUCTION)
# ==============================================================================
DANBOORU_URL=https://danbooru.donmai.us
DANBOORU_USERNAME=your_danbooru_username
DANBOORU_API_KEY=your_danbooru_api_key

# ==============================================================================
# DISCORD & RE-ADD POLICY
# ==============================================================================
DISCORD_TOKEN=your_discord_token_here
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url_here

# Chính sách mặc định khi tag bị xóa: 'never' hoặc số lượt edit (vd: 5)
RE_ADD_POLICY=never

# Số lượng bài tối thiểu của character tag để tự động lấy top 1 copyright khi chưa có trong database
MIN_POST_COUNT_AUTO=1000

# ==============================================================================
# GIT DATABASE REPOSITORY & TỰ ĐỘNG PUSH
# ==============================================================================
DATABASE_REPO_URL=https://github.com/somefoxne/copyright_request_database.git

# GitHub Personal Access Token (Dành cho VPS/Vibe Host push database tự động)
# Tạo token tại: https://github.com/settings/tokens (chọn quyền 'repo')
GITHUB_TOKEN=your_github_personal_access_token_here

# ==============================================================================
# CẬP NHẬT TAG THỦ CÔNG (CÁCH 2 - DỰ PHÒNG KHI CẦN DÙNG)
# ==============================================================================
# Điền danh sách nhân vật cần tra cứu copyright (cách nhau bởi dấu cách).
# Ví dụ: UPDATE_DB_TAGS=shirakami_fubuki usada_pekora minato_aqua
# Khi cần dùng, chỉ cần chạy lệnh: python update_tags.py
UPDATE_DB_TAGS=

